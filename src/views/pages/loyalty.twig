{% extends "layouts.master" %}
{% block content %}
<section class="baynora-loyalty-hero" {% if loyalty.image %}style="background-image:linear-gradient(rgba(43,45,66,.82),rgba(43,45,66,.82)),url('{{ loyalty.image }}')"{% endif %}>
  <div class="baynora-container"><salla-breadcrumb></salla-breadcrumb><div class="baynora-loyalty-hero__content"><span>مكافآت BAYNORA</span><h1>{{ loyalty.name }}</h1><p>{{ loyalty.description }}</p>{% if user.loyalty_points is not null %}<strong>{{ user.loyalty_points }} نقطة</strong>{% endif %}<salla-loyalty data-testid="store-loyalty-exchange" customer-points="{{ user.loyalty_points }}"><salla-button slot="widget" onclick="document.querySelector('salla-loyalty').open();">استبدل نقاطك</salla-button></salla-loyalty></div></div>
</section>
<section class="baynora-section"><div class="baynora-container"><div class="baynora-section__head"><div><span>اكسب أكثر</span><h2>طرق جمع النقاط</h2></div></div><div class="baynora-loyalty-grid">{% for point in loyalty.points %}<article class="baynora-loyalty-card"><i class="{{ point.icon ?: 'sicon-star' }}"></i><strong>{{ point.points }} نقطة</strong><h3>{{ point.name }}</h3><p>{{ point.description }}</p>{% if point.url %}<a href="{{ point.url }}">اعرف أكثر</a>{% endif %}</article>{% endfor %}</div></div></section>
{% for prize_group in loyalty.prizes %}<section class="baynora-section baynora-section--soft"><div class="baynora-container"><div class="baynora-section__head"><div><span>المكافآت</span><h2>{{ prize_group.title }}</h2></div></div><div class="baynora-prize-grid">{% for prize in prize_group.items %}<article class="baynora-prize-card">{% if prize.image %}<img src="{{ prize.image }}" alt="{{ prize.name }}">{% endif %}<h3>{{ prize.name }}</h3><p>{{ prize.description }}</p><strong>{{ prize.cost_points }} نقطة</strong></article>{% endfor %}</div></div></section>{% endfor %}
{% endblock %}
