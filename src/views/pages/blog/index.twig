{% extends "layouts.master" %}
{% block content %}
<section class="baynora-page-head baynora-page-head--simple"><div class="baynora-container"><salla-breadcrumb></salla-breadcrumb><h1>{{ page.title }}</h1></div></section>
<section class="baynora-content-page"><div class="baynora-container baynora-blog-layout"><aside class="baynora-blog-categories"><h3>التصنيفات</h3>{% for category in categories %}<a class="{{ category.is_current ? 'is-active' : '' }}" href="{{ category.url }}">{{ category.name }}</a>{% endfor %}</aside><div class="baynora-blog-grid">{% for article in articles %}<article class="baynora-blog-card">{% if article.has_image %}<a href="{{ article.url }}"><img src="{{ article.image.url }}" alt="{{ article.image.alt }}"></a>{% endif %}<div><small>{{ article.created_at|date }} · {{ article.author.name }}</small><h2><a href="{{ article.url }}">{{ article.title }}</a></h2><p>{{ article.summary }}</p><a class="baynora-blog-readmore" href="{{ article.url }}">اقرأ المقال</a></div></article>{% else %}<div class="baynora-empty-state"><i class="sicon-inbox"></i><h2>لا توجد مقالات حاليًا</h2></div>{% endfor %}</div></div></section>
{% endblock %}
