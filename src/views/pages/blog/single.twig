{% extends "layouts.master" %}
{% block content %}
<section class="baynora-content-page"><div class="baynora-container"><salla-breadcrumb></salla-breadcrumb><article class="baynora-article"><header><small>{{ article.created_at|date }} · {{ article.author.name }}</small><h1>{{ article.title }}</h1></header>{% if article.has_image %}<img class="baynora-article__image" src="{{ article.image.url }}" alt="{{ article.image.alt }}">{% endif %}<div class="baynora-article__body">{{ article.body|replace({'&nbsp;':' '})|raw }}</div>{% if article.tags|length %}<div class="baynora-article__tags">{% for tag in article.tags %}<a href="{{ tag.url }}">#{{ tag.name }}</a>{% endfor %}</div>{% endif %}{% if store.settings.blog.allow_likes_and_comments %}<salla-comments data-testid="store-blog-comments" item-id="{{ article.key }}" type="blog"></salla-comments>{% endif %}</article>{% if related|length %}<section class="baynora-related-articles"><h2>مقالات ذات صلة</h2><div class="baynora-blog-grid">{% for item in related %}<article class="baynora-blog-card">{% if item.has_image %}<a href="{{ item.url }}"><img src="{{ item.image.url }}" alt="{{ item.image.alt }}"></a>{% endif %}<div><h3><a href="{{ item.url }}">{{ item.title }}</a></h3></div></article>{% endfor %}</div></section>{% endif %}</div></section>
{% endblock %}
