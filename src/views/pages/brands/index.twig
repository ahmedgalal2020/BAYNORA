{% extends "layouts.master" %}
{% block content %}
<section class="baynora-page-head baynora-page-head--simple"><div class="baynora-container"><salla-breadcrumb></salla-breadcrumb><h1>{{ page.title }}</h1></div></section>
<section class="baynora-content-page"><div class="baynora-container">
  {% if brands|length %}
    <div class="baynora-brand-groups">
      {% for char, brandGroup in brands %}
        <section class="baynora-brand-group"><h2>{{ char }}</h2><div class="baynora-brand-grid">
          {% for brand in brandGroup %}<a href="{{ brand.url }}" class="baynora-brand-card" data-testid="store-brand-item"><img src="{{ brand.logo }}" alt="{{ brand.name }}"><span>{{ brand.name }}</span></a>{% endfor %}
        </div></section>
      {% endfor %}
    </div>
  {% else %}
    <div class="baynora-empty-state"><i class="sicon-award-ribbon"></i><h2>لا توجد علامات تجارية حاليًا</h2></div>
  {% endif %}
</div></section>
{% endblock %}
